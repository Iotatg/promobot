# Promobot environment configuration
# Copy this file to .env and fill in your own values.

# Telegram application credentials from https://my.telegram.org
API_ID=1234567
API_HASH=your_api_hash_here

# Bot token from @BotFather. Required.
BOT_TOKEN=123456:your-bot-token-here

# Your Telegram user ID (the owner). Only this user can manage the bot.
OWNER_ID=123456789

# (Optional) ID of a private group/channel used for structured status logs.
# The bot must be a member/admin of it. Leave empty to disable remote logging.
LOG_GROUP_ID=

# MongoDB connection.
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=promobot

# TDLib library + data paths (must be writable).
# Leave TDLIB_LIBRARY_PATH empty to use the library installed by
# `go run github.com/Iotatg/gotdbot/scripts/tools`.
TDLIB_LIBRARY_PATH=
TDLIB_DATABASE_DIR=./.tdlib/db
TDLIB_FILES_DIR=./.tdlib/files

# Where media and stickers captured for posts are cached so both the bot and the
# assistant can re-send them.
MEDIA_DIR=./.tdlib/media

# TDLib log verbosity (0 = fatal only, up to 5). Keep low in production.
TDLOG_VERBOSITY=1

# Assistant (userbot): your own account, used to post to channels where it is
# an admin. Set ASSISTANT_SESSION to a Pyrogram StringSession to enable the
# assistant via MTProto (gotd) without an interactive login. On first run the
# bot will prompt for the login code and 2FA password in the terminal; the
# encrypted TDLib session is then reused automatically. Leave empty to disable
# the assistant.
ASSISTANT_PHONE=
ASSISTANT_SESSION=
ASSISTANT_DATABASE_DIR=./.tdlib/assistant_db
ASSISTANT_FILES_DIR=./.tdlib/assistant_files

# Scheduler tuning.
# WARMUP_MINUTES: newly added channels wait this long before their first send.
WARMUP_MINUTES=15
# JITTER_SECONDS: random 0..JITTER_SECONDS added to each interval.
JITTER_SECONDS=45
# MAX_FLOODWAIT_SECONDS: cap on how long to sleep after a FloodWait.
MAX_FLOODWAIT_SECONDS=3600

# Incoming command rate limit (per user): N commands per window (seconds).
RATE_LIMIT_COUNT=20
RATE_LIMIT_WINDOW_SECONDS=60

# LLM chatbot (optional). OpenAI-compatible chat completions endpoint.
# Set USER_LLM_API_KEY to enable /ask, /chat and /model.
# Provide either a full chat URL, or a base URL (the /chat/completions path is
# appended automatically when USER_LLM_CHAT_URL is empty).
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.example.com/v1
USER_LLM_CHAT_URL=
USER_LLM_MODEL=free/gemini-4-hydrogen

# AI persona (Radhika). These shape the chatbot's identity and voice.
PERSONA_NAME=Radhika
PERSONA_AGE=20
PERSONA_DOB=14 February 2006
PERSONA_FROM=Jaipur, India